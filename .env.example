APP_ENV=production
APP_URL=https://yourdomain.com
# Public origin of the React SPA; GET / on the API redirects there (optional)
FRONTEND_URL=

DB_HOST=localhost
DB_PORT=5432
DB_NAME=coffeetime
DB_USER=coffeetime
DB_PASS=secret
# Optional: unix socket dir, takes priority over DB_HOST/DB_PORT when set
# (e.g. Cloud SQL / a local Postgres socket install). Leave unset otherwise.
# DB_SOCKET=/var/run/postgresql

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
LIQPAY_SANDBOX=1

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Coffee Time

SESSION_LIFETIME=3600

# Supabase Storage for product/gallery/slide images (optional; local disk otherwise)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=media
# Contacts shown in the reminder e-mail footer
CAFE_PHONE=
CAFE_INSTAGRAM=
